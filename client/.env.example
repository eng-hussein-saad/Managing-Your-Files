# Public, browser-reachable Express origin (never contains secrets)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Non-secret server-only Express authority origin
AUTH_API_BASE_URL=http://localhost:3001
# Secret matching server BFF_SHARED_SECRET
AUTH_BFF_SHARED_SECRET=replace-with-at-least-32-random-characters
# Non-secret host-only cookie policy; Secure=false is local HTTP only
REFRESH_COOKIE_NAME=fileora_refresh
REFRESH_COOKIE_PATH=/api/auth
REFRESH_COOKIE_SAME_SITE=strict
REFRESH_COOKIE_SECURE=false
# Non-secret lifetime matching the server value
REFRESH_TOKEN_TTL=30d

