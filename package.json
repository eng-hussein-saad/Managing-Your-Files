{
  "name": "gold-era",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24 <25" },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run --project unit --project contract --project component",
    "test:integration": "vitest run --project integration --maxWorkers=1 --no-file-parallelism",
    "test:e2e": "playwright test --workers=1",
    "test:security": "vitest run --project security"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
