# Non-secret server listener (1-65535)
PORT=3001
# Secret PostgreSQL connection string
DATABASE_URL=postgresql://fileora:replace-me@localhost:5432/fileora
# Secret, at least 32 characters
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
# Non-secret positive durations
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Secret shared only with the Next.js gateway
BFF_SHARED_SECRET=replace-with-at-least-32-random-characters
# Non-secret explicit browser origins; wildcards are rejected
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Non-secret mail transport settings and secret credentials
EMAIL_FROM=Fileora <noreply@example.invalid>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
# Secret bootstrap identity and password; name is non-secret
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace-with-an-8-character-password
ADMIN_NAME=Fileora Administrator
# File management: URL/bucket and limits are non-secret; the service-role key is server-only.
SUPABASE_URL=https://example.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_STORAGE_BUCKET=fileora-private-files
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
USER_STORAGE_QUOTA_BYTES=104857600
UPLOAD_ALLOWED_MIME_TYPES=application/pdf,text/plain,image/jpeg,image/png,image/webp,application/vnd.openxmlformats-officedocument.wordprocessingml.document
UPLOAD_MAX_FILES_PER_BATCH=10
FILE_EXTRACTION_MAX_BYTES=5242880
