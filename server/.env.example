# Non-secret server listener (1-65535)
PORT=3001
# Secret PostgreSQL connection string
DATABASE_URL=postgresql://gold_era:replace-me@localhost:5432/gold_era
# Secret, at least 32 characters
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
# Non-secret positive durations
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Secret shared only with the Next.js gateway
BFF_SHARED_SECRET=replace-with-at-least-32-random-characters
# Non-secret explicit browser origins; wildcards are rejected
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Non-secret mail transport settings and secret credentials
EMAIL_FROM=Gold Era <noreply@example.invalid>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
# Secret bootstrap identity and password; name is non-secret
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace-with-an-8-character-password
ADMIN_NAME=Gold Era Administrator
