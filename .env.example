# Docker Compose environment


# PostgreSQL container and host port
POSTGRES_DB=fileora
POSTGRES_USER=fileora
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5432

# Express API. The database host must match the postgres service name in compose.yaml.
PORT=3001
DATABASE_URL=postgresql://fileora:replace-with-a-strong-password@postgres:5432/fileora
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
BFF_SHARED_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=http://localhost:3000

# SMTP transport and sender
EMAIL_FROM=Fileora <noreply@example.invalid>
SMTP_HOST=replace-with-your-smtp-host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me

# Initial administrator
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace-with-an-8-character-password
ADMIN_NAME=Fileora Administrator

# Private Supabase Storage bucket and server-only secret key
SUPABASE_URL=https://example.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_STORAGE_BUCKET=fileora-private-files

# Browser-reachable API URL and refresh-cookie policy
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
REFRESH_COOKIE_NAME=fileora_refresh
REFRESH_COOKIE_SAME_SITE=strict
REFRESH_COOKIE_SECURE=false
